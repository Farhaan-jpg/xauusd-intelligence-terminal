# ==============================================================================
# XAUUSD Intelligence Terminal - Environment Variables Configuration
# ==============================================================================

# Server Configuration
PORT=8000
ENVIRONMENT=production
DEMO_MODE=true
SECRET_KEY=replace_with_a_secure_random_key

# Timezone (Default IST: Asia/Kolkata)
TIMEZONE=Asia/Kolkata

# Persistence: SQLite for 100% Free Render Hosting, or PostgreSQL connection string
DATABASE_URL=sqlite:///./terminal.db
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# Risk Guardrail Default Thresholds
DEFAULT_CONTRACT_SIZE=100.0
DEFAULT_TICK_SIZE=0.01
DEFAULT_TICK_VALUE=1.00
DEFAULT_MAX_DAILY_LOSS_PCT=3.0
DEFAULT_MAX_TRADE_RISK_PCT=1.0
DEFAULT_MAX_DAILY_TRADES=5

# News Blackout Window (Minutes before and after high-impact events)
NEWS_LOCKOUT_WINDOW_MINUTES=15

# Frontend Connection URL (For Next.js rewrites)
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
